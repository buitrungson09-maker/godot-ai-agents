# Chon provider cho AI Planner: direct hoac omniroute.
LLM_PROVIDER=direct

# OpenAI direct (bat buoc khi LLM_PROVIDER=direct).
OPENAI_API_KEY=
OPENAI_MODEL=

# OmniRoute (bat buoc khi LLM_PROVIDER=omniroute).
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
